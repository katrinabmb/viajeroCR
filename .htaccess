RewriteEngine On

# CORS is sent once from src/bootstrap.php (allowed_origins in config/app.php).
# Duplicate Access-Control-Allow-* headers here break browsers and cause fetch()
# from http://localhost:5174 (Vite) to fail with NETWORK_ERROR.

# Let existing files and directories resolve normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send application routes to the front controller.
RewriteRule ^ index.php [QSA,L]
